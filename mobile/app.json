{
  "expo": {
    "name": "Home Helper",
    "slug": "home-helper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.homehelper.family"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.homehelper.family"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Home Helper",
      "shortName": "Home Helper",
      "themeColor": "#4F46E5",
      "backgroundColor": "#F6F7F4",
      "display": "standalone",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Home Helper to take photos for your records."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Home Helper to count your steps."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Home Helper to read your calendar for your morning briefing, reviews and trip checklists."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Home Helper to use your location for the local forecast."
        }
      ]
    ],
    "scheme": "homehelper",
    "experiments": {
      "typedRoutes": true
    }
  }
}
