# The household server's settings. Copy to deploy/.env (git-ignored) and fill in the blanks.
# Everything here is chosen to cost €0 a month. See deploy/README.md for where each value comes from.

# --- Addresses (two free DuckDNS names pointing at the VM's public IP) -------------------
API_DOMAIN=myhome-api.duckdns.org     # API + web dashboard
APP_DOMAIN=myhome.duckdns.org         # the installable app (PWA)

# --- Laravel -----------------------------------------------------------------------------
APP_NAME="Home Helper"
APP_ENV=production
APP_KEY=                              # docker run --rm home-helper:latest php artisan key:generate --show
APP_DEBUG=false
APP_VERSION=
LOG_CHANNEL=stack
LOG_STACK=json
LOG_LEVEL=info
HOME_TIMEZONE=Europe/Athens
TRUSTED_PROXIES=

# --- Database and Redis (only reachable inside Docker) -----------------------------------
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=home_helper
DB_USERNAME=home_helper
DB_PASSWORD=                          # openssl rand -base64 32
DB_ROOT_PASSWORD=                     # openssl rand -base64 32 (different)
REDIS_CLIENT=phpredis
REDIS_PASSWORD=                       # openssl rand -base64 32
REDIS_PORT=6379
SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SANCTUM_TOKEN_EXPIRATION=129600

# --- Email for invites (free: Brevo 300/day, or a Gmail app password) -------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Home Helper"

# --- Backups: Oracle Object Storage (S3-compatible, Always Free 20 GB) -------------------
BACKUP_DISK=s3
BACKUP_PATH=backups
BACKUP_KEEP=14
AWS_ACCESS_KEY_ID=                    # Oracle "Customer Secret Key"
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-frankfurt-1
AWS_BUCKET=home-helper-backups
AWS_ENDPOINT=https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Monitoring --------------------------------------------------------------------------
OPS_ADMIN_EMAILS=                     # who may open /system/health
OPS_ALERT_EMAIL=

# --- No paid services -------------------------------------------------------------------
AI_PROVIDER=offline                   # keyword assistant, no Anthropic API
ANTHROPIC_API_KEY=
MEMORY_EMBEDDER=local                 # no Voyage API
VOICE_DRIVER=browser                  # the browser's own speech, no voice server
KITCHEN_OCR=tesseract                 # receipt photos read on the server, free
KITCHEN_BARCODES=openfoodfacts        # free, no key
EXPO_ACCESS_TOKEN=                    # optional; Expo push is free
